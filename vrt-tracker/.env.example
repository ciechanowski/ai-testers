# Skopiuj do vrt-tracker/.env (kopia jest w .gitignore) i uzupełnij klucz.
# Wartości stąd nadpisują vrt.json, a zmienna z powłoki nadpisuje oba.
# Nazwy są takie same, jakich używa SDK trackera.
#
# LOGOWANIE DO PANELU (http://localhost:8082) to osobna sprawa niż klucz poniżej:
#   visual-regression-tracker@example.com / 123456
# Tego nie ustawisz zmienną: obraz migracji ma te dane zaszyte i ignoruje
# DEFAULT_USER_EMAIL oraz DEFAULT_USER_PASSWORD. Własne konto zakładasz w panelu.

# Panel stoi na 8082, bo ReportPortal z S05 zajmuje 8080 i 8081.
# VRT_UI_PORT=8082
# VRT_API_PORT=4200
# VRT_DB_PORT=5432

VRT_APIURL=http://localhost:4200
VRT_PROJECT=AiTesters Gallery

# Klucz zaszyty w obrazie migracji, działa od razu po `npm run tracker:up`.
# Własny wygenerujesz w panelu, w menu użytkownika. Nigdy tego nie commituj.
VRT_APIKEY=DEFAULTUSERAPIKEYTOBECHANGED

# Gdy pominiesz, loader weźmie bieżącą gałąź z gita.
# W CI: VRT_BRANCHNAME=${{ github.head_ref || github.ref_name }}
# VRT_BRANCHNAME=main

# true  = brak baseline'u i różnica trafiają do konsoli, bieg zostaje zielony
# false = oba wywalają test
# Na pierwszy bieg zostaw true, bo baseline'u jeszcze nie ma. W CI ustaw false.
VRT_ENABLESOFTASSERT=true

# Identyfikator przebiegu CI, np. ${{ github.run_id }}
# VRT_CIBUILDID=
