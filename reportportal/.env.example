# Lokalna konfiguracja ReportPortala (S05L01).
#
# Skopiuj ten plik do reportportal/.env i uzupełnij RP_APIKEY oraz RP_PROJECT.
# Kopia jest w .gitignore, bo zawiera klucz API. Ten szablon zostaje w repo.
#
# Plik czytają dwie rzeczy naraz:
#   - docker compose, dla portów i hasła administratora,
#   - reportportal/rp.config.ts, dla konfiguracji agenta Playwrighta.
# Zmienna ustawiona w powłoce albo w CI wygrywa z wartością z tego pliku.

## --- stack w Dockerze ---

# Panel ReportPortala. Domyślnie 8080, bo tak jest w całym materiale kursu.
# VRT Tracker z S04L01 stoi celowo na 8082, żeby nie było kolizji.
RP_UI_PORT=8080

# Tablica routingu Traefika. Przydaje się tylko przy diagnozie, panel jej nie potrzebuje.
RP_TRAEFIK_PORT=8081

# Hasło konta superadmin przy PIERWSZYM starcie na pustej bazie.
# Późniejsza zmiana tej zmiennej nic nie da: hasło jest już w bazie.
# Żeby ustawić je od nowa, trzeba wyczyścić wolumen przez `npm run rp:reset`.
# Po pierwszym zalogowaniu ReportPortal i tak wymusi zmianę hasła w panelu.
RP_INITIAL_ADMIN_PASSWORD=erebus

## --- agent Playwrighta ---

# Adres API, nie panelu. Wersja /api/v2 jest obowiązkowa, agent nie dokłada jej sam.
RP_ENDPOINT=http://localhost:8080/api/v2

# Nazwa projektu dokładnie tak, jak została założona w panelu.
# Zweryfikowane na instancji 26.0.3 (service-api 5.15.2): API adresuje projekt nazwą,
# warstwy organizacji w tym wydaniu nie ma. Nazwa musi się zgadzać co do znaku,
# bo przy pomyłce test przechodzi, a lista przebiegów zostaje pusta.
RP_PROJECT=REPLACE_WITH_PROJECT_NAME

# Klucz API z profilu użytkownika w panelu (menu użytkownika, Profile).
# To nie jest hasło do panelu.
RP_APIKEY=REPLACE_WITH_API_KEY_FROM_PROFILE

# Nazwa przebiegu widoczna na liście launchów.
RP_LAUNCH=AiTesters VRT

# Klient JS ReportPortala domyślnie wysyła telemetrię startu przebiegu do Google Analytics.
# W materiale kursowym trzymamy to wyłączone i mówimy o tym wprost.
REPORTPORTAL_CLIENT_JS_NO_ANALYTICS=true

## --- praca domowa S05L04 (opcjonalne) ---

# Na czas pracy domowej podmień wartość RP_LAUNCH wyżej na:
#   AiTesters VRT homework
# Osobna nazwa oddziela przebiegi zadania od tych z lekcji i od danych z seed-demo.mjs,
# więc filtr w panelu zbiera dokładnie te dwa biegi, które sam wypuścisz.

# Ziarno wariantu regresji: wpisz swoje imię. Puste ziarno oznacza bieg czysty,
# czyli ten, na którym nagrywasz baseline'y. Zmienną czyta rp.config.ts z tego pliku,
# więc działa tak samo w PowerShellu i w powłoce uniksowej.
# HW_SEED=anna

## --- przygotowanie instancji przed zajeciami (opcjonalne) ---
## seed.mjs: historia do nauki modelu, prog Auto-Analysis to 300 oznaczonych elementow
# RP_SEED_LAUNCHES=12
# RP_SEED_ITEMS=30
## seed-demo.mjs: material pokazowy do panelu, ze zrzutami w zalacznikach
# RP_DEMO_LAUNCHES=18
# RP_DEMO_DAYS=14
# RP_DEMO_ATTACH=1
# RP_DEMO_LAUNCH=AiTesters VRT
